{
  "name": "owl-coffee",
  "version": "0.1.0",
  "private": true,
  "description": "Owl Coffee monorepo",
  "scripts": {
    "server:dev": "pnpm --filter @owl-coffee/server dev",
    "server:start": "pnpm --filter @owl-coffee/server start",
    "server:stop": "pnpm --filter @owl-coffee/server stop",
    "server:test": "pnpm --filter @owl-coffee/server test"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.6.3"
}
