NODE_ENV=development
SERVER_PORT=7001

# JWT 配置，真实值本地写入 .env，不提交到仓库
JWT_SECRET=待补充
JWT_ACCESS_TOKEN_EXPIRES_IN=2h
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# MySQL 配置占位，后续数据库初始化时启用
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=待补充
MYSQL_USER=待补充
MYSQL_PASSWORD=待补充
MYSQL_CONNECTION_LIMIT=10

# 腾讯云 COS 配置，真实值只写入本地 .env，不提交到仓库
TENCENT_COS_SECRET_ID=待补充
TENCENT_COS_SECRET_KEY=待补充
TENCENT_COS_BUCKET=待补充
TENCENT_COS_REGION=ap-guangzhou

# 可选：自定义 CDN / COS 访问域名，不填则使用默认 COS 访问域名
TENCENT_COS_PUBLIC_BASE_URL=

# 微信小程序配置，真实值只写入本地 .env，不提交到仓库
WECHAT_MINIAPP_APP_ID=待补充
WECHAT_MINIAPP_APP_SECRET=待补充
# 本地临时调试可设为 true；真实联调和部署必须保持 false
WECHAT_MINIAPP_MOCK_LOGIN=false
