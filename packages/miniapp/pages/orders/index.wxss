.orders-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 28rpx;
  background: #f8f4ee;
  color: #2f2118;
}

.status-tabs {
  position: sticky;
  z-index: 10;
  top: 0;
  width: 100%;
  background: #fffdf9;
  box-shadow: 0 8rpx 20rpx rgba(80, 52, 33, 0.04);
  white-space: nowrap;
}

.status-tabs-inner {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 92rpx;
  padding: 0 20rpx;
}

.status-tab {
  position: relative;
  min-width: 120rpx;
  color: #74685f;
  font-size: 26rpx;
  line-height: 58rpx;
  text-align: center;
}

.status-tab.active {
  border: 1rpx solid #f0c9ab;
  border-radius: 30rpx;
  background: #fff5ec;
  color: #e97416;
  font-weight: 700;
}

.status-tab.active::after {
  position: absolute;
  right: 28rpx;
  bottom: 4rpx;
  left: 28rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #e97416;
  content: '';
}

.loading-state {
  padding: 100rpx 0;
  text-align: center;
}

.order-list {
  padding: 20rpx 24rpx 0;
}

.order-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(111, 75, 48, 0.06);
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(83, 55, 35, 0.05);
}

.order-head,
.goods-item,
.order-action-row,
.amount-row {
  display: flex;
  align-items: center;
}

.order-head,
.order-action-row,
.amount-row {
  justify-content: space-between;
}

.order-no {
  color: #776b62;
  font-size: 23rpx;
}

.order-status {
  color: #e97416;
  font-size: 24rpx;
  font-weight: 700;
}

.order-status.completed {
  color: #4d9655;
}

.order-status.muted {
  color: #9b9189;
}

.order-divider {
  height: 1rpx;
  margin: 20rpx 0 16rpx;
  background: #eee7e1;
}

.goods-item {
  margin-bottom: 16rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.goods-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  overflow: hidden;
  flex: none;
  border-radius: 12rpx;
  background: #f4eee6;
}

.goods-image {
  width: 100%;
  height: 100%;
}

.goods-placeholder {
  color: #a0958c;
  font-size: 20rpx;
}

.goods-info {
  min-width: 0;
  margin-left: 20rpx;
  flex: 1;
}

.goods-name {
  overflow: hidden;
  color: #2f2118;
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec,
.goods-empty {
  margin-top: 10rpx;
  color: #9a8e85;
  font-size: 22rpx;
}

.goods-quantity {
  margin-left: 16rpx;
  align-self: flex-start;
  color: #756960;
  font-size: 23rpx;
}

.order-meta {
  margin-top: 18rpx;
  color: #958980;
  font-size: 22rpx;
  line-height: 1.9;
}

.order-action-row {
  min-height: 72rpx;
  margin: 14rpx -8rpx -4rpx;
  padding: 10rpx 8rpx;
  border-radius: 12rpx;
  background: #fff8f1;
}

.pickup-code {
  color: #e97416;
  font-size: 25rpx;
  font-weight: 700;
}

.pickup-code text {
  font-size: 34rpx;
  letter-spacing: 2rpx;
}

.action-spacer {
  flex: 1;
}

.order-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 164rpx;
  height: 60rpx;
  margin: 0;
  border-radius: 10rpx;
  background: #fff;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.order-button::after {
  border-radius: 10rpx;
}

.order-button.primary {
  background: #e97416;
  color: #fff;
}

.order-button.primary::after {
  border: 0;
}

.order-button.success {
  width: 184rpx;
  height: 64rpx;
  margin: 0 0 0 auto;
  background: #e97416;
  box-shadow: 0 8rpx 18rpx rgba(233, 116, 22, 0.22);
  color: #fff;
  line-height: 64rpx;
}

.order-button.success::after {
  border: 0;
}

.amount-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eee7e1;
}

.payment-status {
  color: #9a8e85;
  font-size: 22rpx;
}

.order-amount {
  color: #2f2118;
  font-size: 25rpx;
  font-weight: 700;
}

.list-end {
  padding: 12rpx 0 24rpx;
  color: #aaa098;
  font-size: 21rpx;
  text-align: center;
}

.empty-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin: 120rpx 28rpx 0;
  padding: 72rpx 36rpx;
  border: 1rpx solid rgba(111, 75, 48, 0.06);
  border-radius: 16rpx;
  background: #fffdf9;
  text-align: center;
}

.empty-title {
  font-size: 31rpx;
  font-weight: 700;
}

.empty-desc {
  max-width: 500rpx;
  margin-top: 18rpx;
  color: #8f8072;
  font-size: 24rpx;
  line-height: 1.6;
}

.menu-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 70rpx;
  margin-top: 36rpx;
  border-radius: 10rpx;
  background: #e97416;
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
}

.menu-button::after {
  border: 0;
}
