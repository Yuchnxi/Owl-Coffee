<view class="orders-page">
  <scroll-view class="status-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="status-tabs-inner">
      <view
        class="status-tab {{activeStatus === item.value ? 'active' : ''}}"
        wx:for="{{statusTabs}}"
        wx:key="value"
        data-status="{{item.value}}"
        bindtap="handleStatusChange"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="loading-state" wx:if="{{loading}}">
    <van-loading size="22px" color="#e97416">订单加载中</van-loading>
  </view>

  <view class="empty-card login-card" wx:elif="{{needLogin}}">
    <view class="empty-title">登录后查看订单</view>
    <view class="empty-desc">退出登录后不会自动恢复账号，需要你主动登录后再查看历史订单。</view>
    <van-button
      custom-class="menu-button"
      custom-style="width: 240rpx; height: 70rpx; border: 0; border-radius: 10rpx; background: #e97416; color: #ffffff; font-size: 25rpx; font-weight: 700;"
      loading="{{loading}}"
      bind:click="handleLoginAndLoadOrders"
    >
      登录查看订单
    </van-button>
  </view>

  <view class="order-list" wx:elif="{{orderList.length}}">
    <view
      class="order-card"
      wx:for="{{orderList}}"
      wx:key="id"
      data-order-id="{{item.id}}"
      bindtap="handleOpenDetail"
    >
      <view class="order-head">
        <view class="order-no">订单号：{{item.orderNo}}</view>
        <view class="order-status {{item.statusClass}}">{{item.statusText}}</view>
      </view>

      <view class="order-divider"></view>

      <view class="goods-list" wx:if="{{item.items.length}}">
        <view class="goods-item" wx:for="{{item.items}}" wx:for-item="goods" wx:key="id">
          <view class="goods-cover">
            <image wx:if="{{goods.imageUrl}}" class="goods-image" src="{{goods.imageUrl}}" mode="aspectFill" />
            <view wx:else class="goods-placeholder">待补充</view>
          </view>
          <view class="goods-info">
            <view class="goods-name">{{goods.productName}}</view>
            <view class="goods-spec">{{goods.specText || '规格待补充'}}</view>
          </view>
          <view class="goods-quantity">×{{goods.quantity}}</view>
        </view>
      </view>

      <view class="goods-empty" wx:else>暂无商品明细</view>

      <view class="order-meta">
        <view>下单时间：{{item.createdAtText}}</view>
        <view>到店自提</view>
      </view>

      <view
        class="order-action-row"
        wx:if="{{item.pickupCode || item.isPendingPayment || item.isReadyForPickup || item.isCompleted}}"
        catchtap="handlePreventTap"
      >
        <view class="pickup-code" wx:if="{{item.pickupCode}}">
          取餐码：<text>{{item.pickupCode}}</text>
        </view>
        <view class="action-spacer" wx:else></view>
        <van-button
          wx:if="{{item.isPendingPayment}}"
          custom-class="order-button ghost"
          loading="{{cancellingOrderId === item.id}}"
          disabled="{{cancellingOrderId || payingOrderId}}"
          data-order-id="{{item.id}}"
          bind:click="handleCancelOrder"
        >取消订单</van-button>
        <van-button
          wx:if="{{item.isPendingPayment}}"
          custom-class="order-button primary"
          loading="{{payingOrderId === item.id}}"
          disabled="{{payingOrderId || cancellingOrderId}}"
          data-order-id="{{item.id}}"
          bind:click="handleMockPay"
        >模拟支付</van-button>
        <van-button
          wx:elif="{{item.isReadyForPickup}}"
          custom-class="order-button primary"
          loading="{{confirmingOrderId === item.id}}"
          disabled="{{confirmingOrderId}}"
          data-order-id="{{item.id}}"
          bind:click="handleConfirmPickup"
        >确认取餐</van-button>
        <van-button
          wx:elif="{{item.isCompleted}}"
          custom-class="order-button success"
          loading="{{reorderingOrderId === item.id}}"
          disabled="{{reorderingOrderId}}"
          data-order-id="{{item.id}}"
          bind:click="handleOrderAgain"
        >再来一单</van-button>
      </view>

      <view class="amount-row">
        <view class="payment-status">{{item.paymentStatus === 'paid' ? '已模拟支付' : '待支付'}}</view>
        <view class="order-amount">合计 {{item.amountText}}</view>
      </view>
    </view>
    <view class="list-end">— 没有更多了 —</view>
  </view>

  <view class="empty-card" wx:else>
    <view class="empty-title">暂无订单</view>
    <view class="empty-desc">当前分类还没有订单，去点一杯喜欢的咖啡吧</view>
    <button class="menu-button" bindtap="handleGoMenu">去点单</button>
  </view>
</view>
