<view class="home-page">
  <view class="hero-section">
    <swiper
      class="hero-swiper"
      autoplay="{{bannerList.length > 1}}"
      circular="{{bannerList.length > 1}}"
      indicator-dots="{{bannerList.length > 1}}"
      indicator-color="rgba(255, 250, 242, 0.5)"
      indicator-active-color="#e97416"
    >
      <swiper-item wx:for="{{bannerList}}" wx:key="id">
        <view
          class="hero-slide"
          data-link-type="{{item.linkType}}"
          data-link-url="{{item.linkUrl}}"
          bindtap="handleBannerTap"
        >
          <image wx:if="{{item.imageUrl}}" class="hero-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view wx:else class="hero-placeholder">待补充</view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <view class="section-block">
    <view class="section-head">
      <view>
        <view class="section-title">今日推荐</view>
      </view>
      <view class="section-link" data-url="/pages/menu/index" bindtap="handleNavigate">全部</view>
    </view>

    <view class="recommend-loading" wx:if="{{recommendLoading}}">推荐商品加载中...</view>
    <view class="recommend-list" wx:elif="{{recommendList.length}}">
      <view class="recommend-card" wx:for="{{recommendList}}" wx:key="id">
        <view class="product-cover">
          <image wx:if="{{item.imageUrl}}" class="product-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view wx:else class="product-placeholder">待补充</view>
        </view>
        <view class="product-info">
          <view class="product-row">
            <view class="product-name">{{item.name}}</view>
            <view class="product-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
          </view>
          <view class="product-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
          <view class="product-price" wx:if="{{item.priceText}}">{{item.priceText}}</view>
        </view>
      </view>
    </view>
    <view class="recommend-empty" wx:else>暂无推荐商品，待补充</view>
  </view>

  <view class="order-panel">
    <view class="order-head">
      <view class="order-title">当前取餐</view>
      <view class="order-status" wx:if="{{currentOrder}}">{{currentOrder.statusText}}</view>
    </view>

    <view wx:if="{{currentOrderLoading}}" class="order-empty">取餐信息加载中...</view>

    <view wx:elif="{{currentOrder}}" class="current-order" bindtap="handleOpenCurrentOrder">
      <view class="current-order__no">订单号：{{currentOrder.orderNo}}</view>
      <view class="current-order__code">
        取餐码 <text>{{currentOrder.pickupCodeText}}</text>
      </view>
      <view class="current-order__summary">{{currentOrder.itemSummary}}</view>
      <view class="current-order__footer">
        <text>{{currentOrder.amountText}}</text>
        <text>查看详情 ›</text>
      </view>
    </view>

    <block wx:else>
      <view class="order-empty">暂无进行中的订单</view>
      <view class="order-action" data-url="/pages/menu/index" bindtap="handleNavigate">去点一杯</view>
    </block>
  </view>
</view>
