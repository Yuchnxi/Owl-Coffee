.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 48rpx;
  background: #fffaf2;
  color: #2f2118;
}

.hero-section {
  position: relative;
  min-height: 356rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(111, 75, 48, 0.12);
  border-radius: 16rpx;
  background:
    linear-gradient(135deg, rgba(255, 248, 235, 0.96), rgba(245, 220, 184, 0.88)),
    #f7ead8;
  box-shadow: 0 24rpx 56rpx rgba(111, 75, 48, 0.12);
}

.hero-swiper,
.hero-slide {
  width: 100%;
  height: 356rpx;
}

.hero-slide {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding: 40rpx 34rpx;
}

.hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-slide::before {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(90deg, rgba(255, 250, 242, 0.96) 0%, rgba(255, 250, 242, 0.74) 42%, rgba(255, 250, 242, 0.12) 100%);
  content: '';
}

.hero-slide::after {
  position: absolute;
  z-index: 1;
  right: -80rpx;
  bottom: -120rpx;
  width: 300rpx;
  height: 300rpx;
  border: 2rpx solid rgba(111, 75, 48, 0.12);
  border-radius: 50%;
  content: '';
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 420rpx;
}

.brand-kicker {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(233, 116, 22, 0.12);
  color: #b45615;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  line-height: 1.16;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-desc {
  margin-top: 18rpx;
  color: #7d6653;
  font-size: 26rpx;
  line-height: 1.6;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.quick-card {
  display: flex;
  align-items: center;
  min-height: 130rpx;
  box-sizing: border-box;
  padding: 24rpx 22rpx;
  border: 1rpx solid rgba(111, 75, 48, 0.08);
  border-radius: 14rpx;
  background: #fffdf8;
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: #f4e2cc;
  font-size: 34rpx;
}

.quick-content {
  min-width: 0;
  margin-left: 18rpx;
}

.quick-title {
  color: #2f2118;
  font-size: 28rpx;
  font-weight: 700;
}

.quick-desc {
  margin-top: 8rpx;
  color: #8f8072;
  font-size: 22rpx;
  line-height: 1.3;
}

.quick-arrow {
  margin-left: auto;
  color: #c58f61;
  font-size: 36rpx;
  line-height: 1;
}

.section-block {
  margin-top: 34rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #8f8072;
  font-size: 23rpx;
}

.section-link {
  color: #e97416;
  font-size: 26rpx;
  font-weight: 700;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.recommend-card {
  display: flex;
  min-height: 178rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 1rpx solid rgba(111, 75, 48, 0.08);
  border-radius: 14rpx;
  background: #fffdf8;
}

.product-cover {
  flex: 0 0 140rpx;
  width: 140rpx;
  height: 140rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background:
    linear-gradient(135deg, rgba(233, 116, 22, 0.14), rgba(111, 75, 48, 0.12)),
    #f7ead8;
}

.product-image {
  display: block;
  width: 100%;
  height: 100%;
}

.product-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  margin-left: 22rpx;
}

.product-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.product-name {
  overflow: hidden;
  color: #2f2118;
  font-size: 30rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-tag {
  flex: 0 0 auto;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(233, 116, 22, 0.12);
  color: #b45615;
  font-size: 20rpx;
}

.product-desc {
  overflow: hidden;
  margin-top: 12rpx;
  color: #8f8072;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  margin-top: 16rpx;
  color: #e97416;
  font-size: 26rpx;
  font-weight: 800;
}

.order-panel {
  margin-top: 30rpx;
  box-sizing: border-box;
  padding: 26rpx;
  border: 1rpx solid rgba(111, 75, 48, 0.08);
  border-radius: 14rpx;
  background: #f7ead8;
}

.order-title {
  color: #2f2118;
  font-size: 30rpx;
  font-weight: 800;
}

.order-empty {
  margin-top: 14rpx;
  color: #7d6653;
  font-size: 24rpx;
}

.order-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin-top: 22rpx;
  padding: 0 28rpx;
  border-radius: 10rpx;
  background: #e97416;
  color: #fffaf2;
  font-size: 26rpx;
  font-weight: 700;
}
