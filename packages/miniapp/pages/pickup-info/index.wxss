.pickup-page {
  min-height: 100vh;
  background: #f8f4ee;
  color: #2f2118;
}

.loading-state {
  padding: 100rpx 0;
  text-align: center;
}

.pickup-list {
  padding: 24rpx;
}

.pickup-card,
.empty-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(111, 75, 48, 0.07);
  border-radius: 16rpx;
  background: #fffdf9;
  box-shadow: 0 10rpx 28rpx rgba(83, 55, 35, 0.05);
}

.card-head,
.order-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #74685f;
  font-size: 24rpx;
}

.status-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff2e5;
  color: #e97416;
  font-size: 22rpx;
  font-weight: 800;
}

.pickup-code {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #fff3e6;
  color: #e97416;
  font-size: 26rpx;
  font-weight: 800;
}

.pickup-code text {
  margin-left: 16rpx;
  font-size: 46rpx;
  letter-spacing: 3rpx;
}

.pickup-code.muted {
  background: #f5eee7;
  color: #9a8e85;
}

.order-summary {
  margin-top: 22rpx;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-meta {
  margin-top: 14rpx;
  color: #8f8072;
  font-size: 23rpx;
}

.empty-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin: 120rpx 28rpx 0;
  text-align: center;
}

.empty-title {
  margin-bottom: 24rpx;
  font-size: 31rpx;
  font-weight: 800;
}

.empty-desc {
  color: #8f8072;
  font-size: 24rpx;
}
