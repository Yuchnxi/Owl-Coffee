<view class="detail-page">
  <view class="loading-state" wx:if="{{loading}}">
    <van-loading size="22px" color="#e97416">订单详情加载中</van-loading>
  </view>

  <block wx:elif="{{order}}">
    <view class="summary-card">
      <view class="summary-top">
        <view>
          <view class="summary-label">订单号</view>
          <view class="order-no">{{order.orderNo}}</view>
        </view>
        <view class="status-pill">{{order.statusText}}</view>
      </view>
      <view class="pickup-code" wx:if="{{order.pickupCode}}">
        取餐码 <text>{{order.pickupCode}}</text>
      </view>
      <view class="summary-row">
        <view>支付状态</view>
        <view>{{order.paymentStatusText}}</view>
      </view>
      <view class="summary-row">
        <view>下单时间</view>
        <view>{{order.createdAtText}}</view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">商品明细</view>
      <view class="goods-item" wx:for="{{order.items}}" wx:key="id">
        <view class="goods-cover">
          <image wx:if="{{item.imageUrl}}" class="goods-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view wx:else class="goods-placeholder">待补充</view>
        </view>
        <view class="goods-info">
          <view class="goods-name">{{item.productName}}</view>
          <view class="goods-spec">{{item.specText || '规格待补充'}}</view>
          <view class="goods-price">{{item.unitPriceText}} × {{item.quantity}}</view>
        </view>
        <view class="goods-subtotal">{{item.subtotalAmountText}}</view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">费用信息</view>
      <view class="amount-row">
        <view>商品金额</view>
        <view>{{order.totalAmountText}}</view>
      </view>
      <view class="amount-row">
        <view>优惠金额</view>
        <view>{{order.discountAmountText}}</view>
      </view>
      <view class="amount-row payable">
        <view>实付金额</view>
        <view>{{order.payAmountText}}</view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">订单备注</view>
      <view class="remark-text">{{order.remark || '无备注'}}</view>
    </view>

    <view class="section-card">
      <view class="section-title">状态时间线</view>
      <view class="timeline-item" wx:for="{{order.timeline}}" wx:key="label">
        <view class="timeline-dot"></view>
        <view class="timeline-copy">
          <view class="timeline-label">{{item.label}}</view>
          <view class="timeline-time">{{item.timeText}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
