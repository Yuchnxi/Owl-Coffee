.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f8f4ee;
  color: #2f2118;
}

.loading-state {
  padding: 120rpx 0;
  text-align: center;
}

.summary-card,
.section-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(111, 75, 48, 0.07);
  border-radius: 16rpx;
  background: #fffdf9;
  box-shadow: 0 10rpx 28rpx rgba(83, 55, 35, 0.05);
}

.summary-top,
.summary-row,
.goods-item,
.amount-row,
.timeline-item {
  display: flex;
  align-items: center;
}

.summary-top,
.summary-row,
.amount-row {
  justify-content: space-between;
}

.summary-label {
  color: #958980;
  font-size: 22rpx;
}

.order-no {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.status-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff2e5;
  color: #e97416;
  font-size: 23rpx;
  font-weight: 800;
}

.pickup-code {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #fff3e6;
  color: #e97416;
  font-size: 26rpx;
  font-weight: 800;
}

.pickup-code text {
  margin-left: 16rpx;
  font-size: 44rpx;
  letter-spacing: 3rpx;
}

.summary-row {
  margin-top: 20rpx;
  color: #74685f;
  font-size: 24rpx;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.goods-item {
  margin-bottom: 18rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.goods-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  overflow: hidden;
  flex: none;
  border-radius: 12rpx;
  background: #f4eee6;
}

.goods-image {
  width: 100%;
  height: 100%;
}

.goods-placeholder {
  color: #a0958c;
  font-size: 20rpx;
}

.goods-info {
  min-width: 0;
  margin-left: 20rpx;
  flex: 1;
}

.goods-name {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec,
.goods-price,
.remark-text,
.timeline-time {
  margin-top: 8rpx;
  color: #8f8072;
  font-size: 22rpx;
}

.goods-subtotal,
.payable {
  color: #e97416;
  font-weight: 900;
}

.amount-row {
  min-height: 62rpx;
  color: #74685f;
  font-size: 25rpx;
}

.payable {
  margin-top: 10rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eee7e1;
  color: #2f2118;
}

.timeline-item {
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 10rpx 18rpx 0 2rpx;
  flex: none;
  border-radius: 50%;
  background: #e97416;
}

.timeline-label {
  font-size: 25rpx;
  font-weight: 800;
}
