.cart-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 184rpx;
  background: #faf6f0;
  color: #2f2118;
}

.section-card,
.loading-card,
.empty-card {
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(111, 75, 48, 0.07);
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(83, 55, 35, 0.06);
}

.loading-card {
  padding: 40rpx;
  color: #8f8072;
  font-size: 25rpx;
  text-align: center;
}

.pickup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
}

.pickup-heading {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.pickup-title,
.section-title,
.empty-title {
  color: #2f2118;
  font-size: 30rpx;
  font-weight: 800;
}

.store-tag {
  padding: 8rpx 14rpx;
  border: 2rpx solid #e97416;
  border-radius: 12rpx;
  color: #e97416;
  font-size: 22rpx;
}

.info-row,
.option-row,
.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-row {
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 30rpx;
  border-top: 1rpx solid #eee7e1;
}

.row-label {
  color: #2f2118;
  font-size: 27rpx;
}

.row-value,
.option-value,
.amount-value {
  color: #8f8072;
  font-size: 25rpx;
}

.product-card {
  padding: 28rpx 30rpx 10rpx;
}

.cart-item {
  display: flex;
  min-height: 140rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #eee7e1;
}

.cart-item:last-child {
  border-bottom: 0;
}

.item-cover {
  width: 132rpx;
  height: 132rpx;
  overflow: hidden;
  flex: 0 0 132rpx;
  border-radius: 16rpx;
  background: #f7ead8;
}

.item-image,
.image-placeholder {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a18d7b;
  font-size: 22rpx;
}

.item-info {
  min-width: 0;
  margin-left: 24rpx;
  flex: 1;
}

.item-name {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec {
  margin-top: 14rpx;
  color: #8f8072;
  font-size: 23rpx;
}

.item-stepper {
  margin-top: 18rpx;
}

.item-summary {
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  flex-direction: column;
  min-width: 124rpx;
  margin-left: 16rpx;
  padding: 4rpx 0 8rpx;
}

.item-price,
.payable-value,
.total-price {
  color: #e97416;
  font-weight: 900;
}

.swipe-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 100%;
  background: #d9534f;
  color: #fff;
  font-size: 25rpx;
}

.item-price {
  font-size: 27rpx;
}

.option-row {
  min-height: 94rpx;
  box-sizing: border-box;
  padding: 0 30rpx;
}

.option-row + .option-row {
  border-top: 1rpx solid #eee7e1;
}

.option-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  margin-left: 24rpx;
}

.option-copy {
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount-card {
  padding-top: 12rpx;
}

.amount-row {
  min-height: 76rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
}

.payable-row {
  min-height: 94rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #eee7e1;
  color: #e97416;
  font-size: 28rpx;
}

.payable-value {
  font-size: 34rpx;
}

.empty-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin-top: 120rpx;
  padding: 72rpx 36rpx;
}

.empty-desc {
  margin-top: 16rpx;
  color: #8f8072;
  font-size: 23rpx;
}

.menu-button,
.remark-button {
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.menu-button {
  width: 240rpx;
  height: 76rpx;
  margin-top: 36rpx;
  background: #e97416;
  color: #fff;
  line-height: 76rpx;
}

.menu-button::after,
.submit-button::after,
.remark-button::after {
  border: 0;
}

.checkout-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  min-height: 138rpx;
  box-sizing: border-box;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -10rpx 30rpx rgba(58, 39, 28, 0.06);
}

.checkout-total {
  min-width: 220rpx;
  flex: 1;
}

.total-label {
  color: #6f4b30;
  font-size: 23rpx;
}

.total-price {
  margin-top: 8rpx;
  font-size: 34rpx;
}

.checkout-divider {
  width: 1rpx;
  height: 66rpx;
  margin: 0 28rpx 0 10rpx;
  background: #eee7e1;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 300rpx;
  height: 82rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background: #e97416;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.submit-button[disabled] {
  background: #d8cfc4;
  color: #fff;
}

.remark-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(38, 28, 21, 0.48);
}

.remark-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 16rpx 16rpx 0 0;
  background: #fffdf9;
}

.remark-head,
.remark-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.remark-title {
  font-size: 30rpx;
  font-weight: 800;
}

.remark-limit {
  color: #9a8e85;
  font-size: 22rpx;
}

.remark-input {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  background: #f7efe6;
  color: #2f2118;
  font-size: 25rpx;
}

.remark-actions {
  gap: 20rpx;
  margin-top: 24rpx;
}

.remark-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin: 0;
  padding: 0;
  flex: 1;
  line-height: 1;
}

.remark-button.cancel {
  background: #f3ece4;
  color: #6f6258;
}

.remark-button.confirm {
  background: #e97416;
  color: #fff;
}
