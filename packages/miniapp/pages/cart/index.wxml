<view class="cart-page">
  <view class="loading-card" wx:if="{{loading}}">正在同步订单信息...</view>

  <block wx:elif="{{cartItems.length}}">
    <view class="section-card pickup-card">
      <view class="pickup-head">
        <view class="pickup-heading">
          <van-icon name="shop-o" size="28px" color="#2f2118" />
          <view class="pickup-title">到店自提</view>
        </view>
        <view class="store-tag">单店</view>
      </view>
      <view class="info-row">
        <view class="row-label">自提门店</view>
        <view class="row-value">待补充</view>
      </view>
      <view class="info-row">
        <view class="row-label">取餐时间</view>
        <view class="row-value">立即取餐</view>
      </view>
    </view>

    <view class="section-card product-card">
      <view class="section-title">商品信息</view>
      <van-swipe-cell wx:for="{{cartItems}}" wx:key="key" right-width="72">
        <view class="cart-item">
          <view class="item-cover">
            <image wx:if="{{item.imageUrl}}" class="item-image" src="{{item.imageUrl}}" mode="aspectFill" />
            <view wx:else class="image-placeholder">待补充</view>
          </view>
          <view class="item-info">
            <view class="item-name">{{item.productName}}</view>
            <view class="item-spec">{{item.specText}}</view>
            <view class="item-stepper">
              <van-stepper
                value="{{item.quantity}}"
                min="1"
                max="{{item.stock || 1}}"
                button-size="27"
                data-key="{{item.key}}"
                bind:change="handleQuantityChange"
              />
            </view>
          </view>
          <view class="item-summary">
            <view class="item-price">{{item.subtotalText}}</view>
          </view>
        </view>
        <view
          slot="right"
          class="swipe-delete"
          data-key="{{item.key}}"
          bindtap="handleRemoveItem"
        >删除</view>
      </van-swipe-cell>
    </view>

    <view class="section-card option-card">
      <view class="option-row" bindtap="handleCouponTap">
        <view class="row-label">优惠</view>
        <view class="option-value">
          <text>暂无可用优惠</text>
          <text class="option-arrow">›</text>
        </view>
      </view>
      <view class="option-row" bindtap="handleOpenRemark">
        <view class="row-label">订单备注</view>
        <view class="option-value">
          <text class="option-copy">{{remark || '选填，请填写口味等要求'}}</text>
          <text class="option-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="section-card amount-card">
      <view class="amount-row">
        <view>商品金额</view>
        <view class="amount-value">{{totalAmountText}}</view>
      </view>
      <view class="amount-row">
        <view>优惠金额</view>
        <view class="amount-value">{{discountAmountText}}</view>
      </view>
      <view class="amount-row payable-row">
        <view>应付金额</view>
        <view class="payable-value">{{totalAmountText}}</view>
      </view>
    </view>
  </block>

  <view class="empty-card" wx:else>
    <view class="empty-title">购物车还是空的</view>
    <view class="empty-desc">先去菜单选择喜欢的咖啡吧</view>
    <button class="menu-button" bindtap="handleGoMenu">去点单</button>
  </view>

  <view class="checkout-bar" wx:if="{{cartItems.length}}">
    <view class="checkout-total">
      <view class="total-label">合计</view>
      <view class="total-price">{{totalAmountText}}</view>
      <view wx:if="{{needLogin}}" class="login-hint">登录后提交订单</view>
    </view>
    <view class="checkout-divider"></view>
    <van-button
      custom-class="submit-button"
      custom-style="width: 220rpx; height: 80rpx; border: 0; border-radius: 999rpx; background: #e97416; color: #ffffff; font-size: 28rpx; font-weight: 700;"
      disabled="{{submitting || loading}}"
      loading="{{submitting}}"
      bind:click="handleSubmitOrder"
    >{{needLogin ? '登录提交' : '提交订单'}}</van-button>
  </view>

  <view class="remark-mask" wx:if="{{remarkVisible}}" bindtap="handleCloseRemark">
    <view class="remark-panel" catchtap="handlePreventTap">
      <view class="remark-head">
        <view class="remark-title">订单备注</view>
        <view class="remark-limit">{{remarkDraft.length}}/500</view>
      </view>
      <textarea
        class="remark-input"
        value="{{remarkDraft}}"
        maxlength="500"
        focus
        placeholder="请输入口味等要求"
        bindinput="handleRemarkInput"
      />
      <view class="remark-actions">
        <button class="remark-button cancel" bindtap="handleCloseRemark">取消</button>
        <button class="remark-button confirm" bindtap="handleSaveRemark">确认</button>
      </view>
    </view>
  </view>
</view>
