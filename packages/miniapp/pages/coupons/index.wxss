.coupon-page {
  min-height: 100vh;
  background: #f8f4ee;
  color: #2f2118;
}

.status-tabs {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 24rpx;
  background: #fffdf9;
  box-shadow: 0 8rpx 20rpx rgba(80, 52, 33, 0.04);
}

.status-tab {
  flex: 1;
  border-radius: 30rpx;
  color: #74685f;
  font-size: 26rpx;
  line-height: 58rpx;
  text-align: center;
}

.status-tab.active {
  border: 1rpx solid #f0c9ab;
  background: #fff5ec;
  color: #e97416;
  font-weight: 800;
}

.loading-state {
  padding: 100rpx 0;
  text-align: center;
}

.coupon-list {
  padding: 24rpx;
}

.coupon-card {
  display: flex;
  align-items: center;
  min-height: 160rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(111, 75, 48, 0.07);
  border-radius: 16rpx;
  background: #fffdf9;
  box-shadow: 0 10rpx 28rpx rgba(83, 55, 35, 0.05);
}

.coupon-discount {
  width: 160rpx;
  flex: none;
  color: #e97416;
  font-size: 36rpx;
  font-weight: 900;
}

.coupon-info {
  min-width: 0;
  margin-left: 20rpx;
}

.coupon-name {
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-meta {
  margin-top: 10rpx;
  color: #8f8072;
  font-size: 23rpx;
}

.empty-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin: 120rpx 28rpx 0;
  padding: 72rpx 36rpx;
  border-radius: 16rpx;
  background: #fffdf9;
  text-align: center;
}

.empty-title {
  margin-bottom: 24rpx;
  font-size: 31rpx;
  font-weight: 800;
}

.empty-desc {
  color: #8f8072;
  font-size: 24rpx;
}
