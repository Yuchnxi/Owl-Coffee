
.mine-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 24rpx;
  background: #fffaf2;
  color: #2f2118;
}

.profile-card,
.action-card,
.menu-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border: 1rpx solid rgba(111, 75, 48, 0.08);
  border-radius: 18rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 30rpx rgba(83, 55, 35, 0.05);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #3a271c;
  color: #f4a15f;
  font-size: 25rpx;
  font-weight: 900;
}

.profile-info {
  margin-left: 24rpx;
}

.profile-name,
.action-title {
  font-size: 29rpx;
  font-weight: 800;
}

.profile-status,
.action-desc {
  margin-top: 10rpx;
  color: #8f8072;
  font-size: 23rpx;
}

.action-card,
.menu-card {
  justify-content: space-between;
  margin-top: 20rpx;
}

.auth-button {
  width: 176rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 10rpx;
  background: #e97416;
  color: #fffaf2;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.auth-button::after {
  border: 0;
}

.done-status {
  color: #4e8b57;
  font-size: 24rpx;
  font-weight: 800;
}

.arrow {
  color: #a18d7b;
  font-size: 48rpx;
}
