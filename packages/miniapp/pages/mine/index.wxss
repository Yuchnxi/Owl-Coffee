.mine-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 72rpx;
  background: #f8efe4;
  color: #2d160f;
}

.hero-section {
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: 44rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #4a2417 0%, #8b4b25 58%, #d47a32 100%);
  box-shadow: 0 18rpx 44rpx rgba(80, 43, 24, 0.18);
}

.hero-top {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 168rpx;
  box-sizing: border-box;
  padding: 30rpx;
}

.profile-content {
  display: flex;
  align-items: center;
  width: 100%;
}

.auth-hit-area {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  opacity: 0;
}

.auth-hit-area::after {
  border: 0;
}

.avatar {
  overflow: hidden;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 120rpx;
  height: 120rpx;
  border: 5rpx solid rgba(255, 247, 237, 0.88);
  border-radius: 50%;
  background: #e8d8c6;
  box-shadow: inset 0 -16rpx 22rpx rgba(89, 55, 32, 0.18);
}

.avatar-image {
  display: block;
  width: 120rpx;
  height: 120rpx;
}

.avatar-eye-row {
  display: flex;
  gap: 14rpx;
}

.avatar-image + .avatar-eye-row {
  display: none;
}

.avatar-eye {
  width: 18rpx;
  height: 18rpx;
  border: 7rpx solid #ffffff;
  border-radius: 50%;
}

.avatar-beak {
  width: 0;
  height: 0;
  margin-top: 8rpx;
  border-top: 13rpx solid #ffffff;
  border-right: 11rpx solid transparent;
  border-left: 11rpx solid transparent;
}

.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.profile-name {
  overflow: hidden;
  color: #fffaf2;
  font-size: 35rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: -66rpx 18rpx 0;
  padding: 24rpx 0 22rpx;
  border-radius: 22rpx;
  background: #fffaf4;
  box-shadow: 0 16rpx 34rpx rgba(88, 58, 35, 0.1);
}

.summary-item {
  position: relative;
  text-align: center;
}

.summary-item + .summary-item::before {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 1rpx;
  height: 56rpx;
  background: rgba(89, 55, 32, 0.1);
  content: '';
}

.summary-value {
  color: #502818;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.1;
}

.summary-label {
  margin-top: 10rpx;
  color: #8a7464;
  font-size: 23rpx;
}

.section-block {
  margin-top: 30rpx;
}

.menu-card {
  overflow: hidden;
  border: 1rpx solid rgba(88, 58, 35, 0.08);
  border-radius: 22rpx;
  background: #fffaf4;
  box-shadow: 0 10rpx 26rpx rgba(88, 58, 35, 0.06);
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 122rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(88, 58, 35, 0.08);
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.menu-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: #5a2b18;
  font-size: 24rpx;
  font-weight: 900;
}

.menu-copy {
  min-width: 0;
  margin-left: 22rpx;
}

.menu-title {
  overflow: hidden;
  color: #2d160f;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 18rpx;
}

.menu-badge {
  margin-right: 14rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f5eadc;
  color: #9a6b45;
  font-size: 22rpx;
}

.menu-arrow {
  color: #b49b88;
  font-size: 42rpx;
  line-height: 1;
}

.icon-image {
  display: block;
  width: 100%;
  height: 100%;
}
