<view class="mine-page">
  <view class="hero-section">
    <view class="hero-top">
      <view class="profile-content">
        <view class="avatar">
          <view class="avatar-eye-row">
            <view class="avatar-eye"></view>
            <view class="avatar-eye"></view>
          </view>
          <view class="avatar-beak"></view>
        </view>

        <view class="profile-main">
          <view class="profile-name">{{user.phoneBound ? (user.nickname || 'Owl Coffee 用户') : '欢迎来到 Owl Coffee'}}</view>
        </view>
      </view>

      <button
        wx:if="{{!user.phoneBound}}"
        class="auth-hit-area"
        open-type="getPhoneNumber"
        bindgetphonenumber="handlePhoneAuthorization"
        loading="{{loading}}"
      ></button>
    </view>
  </view>

  <view class="summary-card">
    <view
      wx:for="{{summaryList}}"
      wx:key="key"
      class="summary-item"
      data-key="{{item.key}}"
      bindtap="handleMenuTap"
    >
      <view class="summary-value">{{item.value}}</view>
      <view class="summary-label">{{item.label}}</view>
    </view>
  </view>

  <view class="section-block">
    <view class="menu-card">
      <view
        wx:for="{{menuList}}"
        wx:key="key"
        class="menu-row"
        data-key="{{item.key}}"
        bindtap="handleMenuTap"
      >
        <view class="menu-left">
          <view class="menu-icon">
            <image wx:if="{{item.iconUrl}}" class="icon-image" src="{{item.iconUrl}}" mode="aspectFit" />
            <text wx:else>{{item.iconText}}</text>
          </view>
          <view class="menu-copy">
            <view class="menu-title">{{item.title}}</view>
          </view>
        </view>
        <view class="menu-right">
          <text wx:if="{{item.badge}}" class="menu-badge">{{item.badge}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
